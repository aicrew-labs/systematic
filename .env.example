# Quote Intelligence — environment variables.
# Copy this file to `.env` and fill in real values. The .env file is gitignored.

# Supabase — the FastAPI backend uses these to query the database.
# Get them from Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# OpenAI — only required for the AI-mode quote endpoint.
OPENAI_API_KEY=sk-...

# Supabase Management API (optional) — used by run_migration.py to apply SQL
# migrations from the command line. Get from Supabase Dashboard → Account → Access Tokens.
SBP_TOKEN=sbp_...

# ERP scraping (optional) — only needed by scratch/check_rms.py.
ERP_USER=your-erp-username
ERP_PASS=your-erp-password
